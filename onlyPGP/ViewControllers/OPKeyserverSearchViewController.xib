<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="5056" systemVersion="13C64" targetRuntime="AppleSDK" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <deployment version="1296" identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="3733"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="OPKeyserverSearchViewController">
            <connections>
                <outlet property="view" destination="kss-01-root" id="kss-99-vw0"/>
                <outlet property="searchBar" destination="kss-02-sbar" id="kss-99-sbr"/>
                <outlet property="tableView" destination="kss-03-tblv" id="kss-99-tbl"/>
                <outlet property="noResultsLabel" destination="kss-04-nrlb" id="kss-99-nrl"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="kss-01-root">
            <rect key="frame" x="0.0" y="0.0" width="320" height="568"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <searchBar contentMode="redraw" placeholder="Search by name, email, or key ID" id="kss-02-sbar">
                    <rect key="frame" x="0.0" y="64" width="320" height="44"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleBottomMargin="YES"/>
                    <connections>
                        <outlet property="delegate" destination="-1" id="kss-88-sbd"/>
                    </connections>
                </searchBar>
                <tableView clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" dataMode="prototypes" style="plain" separatorStyle="default" rowHeight="60" sectionHeaderHeight="22" sectionFooterHeight="22" id="kss-03-tblv">
                    <rect key="frame" x="0.0" y="108" width="320" height="460"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="calibratedWhite"/>
                    <connections>
                        <outlet property="dataSource" destination="-1" id="kss-88-tds"/>
                        <outlet property="delegate" destination="-1" id="kss-88-tdl"/>
                    </connections>
                </tableView>
                <label opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="left" text="No keys found" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" minimumFontSize="10" hidden="YES" id="kss-04-nrlb">
                    <rect key="frame" x="60" y="280" width="200" height="30"/>
                    <autoresizingMask key="autoresizingMask" flexibleLeftMargin="YES" flexibleRightMargin="YES" flexibleTopMargin="YES" flexibleBottomMargin="YES"/>
