<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="5056" systemVersion="13C64" targetRuntime="AppleSDK" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <deployment version="1296" identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="3733"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="OPQRDisplayViewController">
            <connections>
                <outlet property="view" destination="qrd-01-root" id="qrd-99-vw0"/>
                <outlet property="qrImageView" destination="qrd-02-imgv" id="qrd-99-img"/>
                <outlet property="pageLabel" destination="qrd-03-plbl" id="qrd-99-plb"/>
                <outlet property="previousButton" destination="qrd-04-prev" id="qrd-99-prv"/>
                <outlet property="nextButton" destination="qrd-05-next" id="qrd-99-nxt"/>
                <outlet property="autoAdvanceSwitch" destination="qrd-06-swch" id="qrd-99-swc"/>
                <outlet property="autoAdvanceLabel" destination="qrd-07-albl" id="qrd-99-alb"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="qrd-01-root">
            <rect key="frame" x="0.0" y="0.0" width="320" height="568"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" id="qrd-02-imgv">
                    <rect key="frame" x="35" y="80" width="250" height="250"/>
                    <autoresizingMask key="autoresizingMask" flexibleLeftMargin="YES" flexibleRightMargin="YES"/>
                </imageView>
                <label opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="left" text="Code 1 of 1" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" minimumFontSize="10" id="qrd-03-plbl">
                    <rect key="frame" x="60" y="345" width="200" height="30"/>
                    <autoresizingMask key="autoresizingMask" flexibleLeftMargin="YES" flexibleRightMargin="YES"/>
                    <fontDescription key="fontDescription" type="system" pointSize="17"/>
                    <color key="textColor" cocoaTouchSystemColor="darkTextColor"/>
                </label>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" id="qrd-04-prev">
                    <rect key="frame" x="20" y="390" width="130" height="44"/>
                    <autoresizingMask key="autoresizingMask" flexibleRightMargin="YES"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="17"/>
                    <state key="normal" title="Previous"/>
                    <connections>
                        <action selector="previousTapped:" destination="-1" eventType="touchUpInside" id="qrd-88-prv"/>
                    </connections>
                </button>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" id="qrd-05-next">
                    <rect key="frame" x="170" y="390" width="130" height="44"/>
                    <autoresizingMask key="autoresizingMask" flexibleLeftMargin="YES"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="17"/>
                    <state key="normal" title="Next"/>
                    <connections>
                        <action selector="nextTapped:" destination="-1" eventType="touchUpInside" id="qrd-88-nxt"/>
                    </connections>
                </button>
                <switch opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" on="NO" id="qrd-06-swch">
                    <rect key="frame" x="200" y="454" width="79" height="31"/>
                    <autoresizingMask key="autoresizingMask" flexibleLeftMargin="YES"/>
                    <connections>
                        <action selector="autoAdvanceToggled:" destination="-1" eventType="valueChanged" id="qrd-88-swc"/>
                    </connections>
                </switch>
                <label opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="left" text="Auto-advance" textAlignment="right" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" minimumFontSize="10" id="qrd-07-albl">
                    <rect key="frame" x="40" y="458" width="150" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleRightMargin="YES"/>
                    <fontDescription key="fontDescription" type="system" pointSize="15"/>
                    <color key="textColor" cocoaTouchSystemColor="darkTextColor"/>
                </label>
            </subviews>
            <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="calibratedWhite"/>
        </view>
    </objects>
</document>
