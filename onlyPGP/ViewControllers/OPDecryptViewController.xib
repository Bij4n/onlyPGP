<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="5056" systemVersion="13C64" targetRuntime="AppleSDK" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <deployment version="1296" identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="3733"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="OPDecryptViewController">
            <connections>
                <outlet property="view" destination="dec-01-root" id="dec-99-vw0"/>
                <outlet property="inputTextView" destination="dec-02-itxv" id="dec-99-itx"/>
                <outlet property="decryptButton" destination="dec-03-dbtn" id="dec-99-dbt"/>
                <outlet property="resultsContainer" destination="dec-04-rcon" id="dec-99-rcn"/>
                <outlet property="plaintextTextView" destination="dec-05-ptxv" id="dec-99-ptx"/>
                <outlet property="signatureStatusLabel" destination="dec-06-sslb" id="dec-99-ssl"/>
                <outlet property="verificationLabel" destination="dec-07-vlbl" id="dec-99-vlb"/>
                <outlet property="copyPlaintextButton" destination="dec-08-cpbt" id="dec-99-cpb"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="dec-01-root">
            <rect key="frame" x="0.0" y="0.0" width="320" height="568"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" editable="YES" id="dec-02-itxv">
                    <rect key="frame" x="0" y="64" width="320" height="190"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                    <fontDescription key="fontDescription" name="Courier" family="Courier" pointSize="12"/>
                    <color key="textColor" cocoaTouchSystemColor="darkTextColor"/>
                    <connections>
                        <outlet property="delegate" destination="-1" id="dec-88-txd"/>
                    </connections>
                </textView>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" id="dec-03-dbtn">
                    <rect key="frame" x="15" y="262" width="290" height="40"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="17"/>
                    <state key="normal" title="Decrypt"/>
                    <connections>
                        <action selector="decryptTapped:" destination="-1" eventType="touchUpInside" id="dec-88-dbt"/>
                    </connections>
                </button>
                <view contentMode="scaleToFill" hidden="YES" id="dec-04-rcon">
                    <rect key="frame" x="0" y="310" width="320" height="258"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <subviews>
                        <label opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="left" text="" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" minimumFontSize="10" id="dec-06-sslb">
                            <rect key="frame" x="15" y="5" width="290" height="20"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                            <fontDescription key="fontDescription" type="boldSystem" pointSize="13"/>
                            <color key="textColor" cocoaTouchSystemColor="darkTextColor"/>
                        </label>
                        <label opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="left" text="" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" minimumFontSize="10" id="dec-07-vlbl">
                            <rect key="frame" x="15" y="27" width="290" height="18"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                            <fontDescription key="fontDescription" type="system" pointSize="12"/>
                            <color key="textColor" red="0.6" green="0.6" blue="0.6" alpha="1" colorSpace="calibratedRGB"/>
                        </label>
                        <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" editable="NO" id="dec-05-ptxv">
                            <rect key="frame" x="0" y="50" width="320" height="160"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <fontDescription key="fontDescription" type="system" pointSize="14"/>
                            <color key="textColor" cocoaTouchSystemColor="darkTextColor"/>
                        </textView>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" id="dec-08-cpbt">
                            <rect key="frame" x="15" y="218" width="290" height="34"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleTopMargin="YES"/>
                            <fontDescription key="fontDescription" type="system" pointSize="15"/>
                            <state key="normal" title="Copy Plaintext"/>
                            <connections>
                                <action selector="copyPlaintextTapped:" destination="-1" eventType="touchUpInside" id="dec-88-cpb"/>
                            </connections>
                        </button>
                    </subviews>
                    <color key="backgroundColor" white="0.95" alpha="1" colorSpace="custom" customColorSpace="calibratedWhite"/>
                </view>
            </subviews>
            <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="calibratedWhite"/>
        </view>
    </objects>
</document>
